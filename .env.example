# --- Serveur ---
PORT=3000
APP_URL=http://localhost:3000
JWT_SECRET=change-moi-en-production-avec-une-longue-chaine-aleatoire

# --- Paiements ---
# Fournisseur principal pour Mobile Money (MTN MoMo / Orange Money Cameroun) :
#   simulator | notchpay | campay | flutterwave
PAYMENT_PROVIDER=simulator
# Commission plateforme (en %) prélevée sur chaque cours
COMMISSION_RATE=12

# NotchPay (https://notchpay.co) - MTN MoMo, Orange Money, cartes
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_PRIVATE_KEY=
NOTCHPAY_HASH_KEY=

# CamPay (https://campay.net) - MTN MoMo, Orange Money
CAMPAY_BASE_URL=https://demo.campay.net/api
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
CAMPAY_WEBHOOK_KEY=

# Flutterwave (https://flutterwave.com) - cartes Visa/Mastercard (diaspora), Mobile Money XAF
FLW_SECRET_KEY=
FLW_SECRET_HASH=

# --- Classe virtuelle (WebRTC) ---
# Serveur TURN conseillé en production (ex : coturn) pour les réseaux mobiles 3G/4G
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
